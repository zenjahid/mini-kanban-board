# Optional overrides used by docker-compose.yml (copy to .env before `docker compose up`).

# Strong random secret used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-secret

# Public URL the web app uses to reach the API (defaults to localhost)
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Restrict API CORS to a specific origin (defaults to *)
# CORS_ORIGIN=http://localhost:3000