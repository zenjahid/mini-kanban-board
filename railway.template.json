{
  "$schema": "https://railway.app/railway.schema.json",
  "$schema_comment": "One-click full-stack deploy template for the Kanban app. After deploying, set the two SET-*-DOMAIN variables below to the real *.up.railway.app URLs (they are assigned at deploy time).",
  "services": {
    "postgres": {
      "type": "postgresql"
    },
    "backend": {
      "type": "github",
      "repo": "zenjahid/mini-kanban-board",
      "branch": "master",
      "rootDirectory": "backend",
      "build": {
        "builder": "DOCKERFILE"
      },
      "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 180,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "variables": {
        "DATABASE_URL": "${{postgres.DATABASE_URL}}",
        "JWT_SECRET": "change-me-to-a-long-random-secret",
        "CORS_ORIGIN": "https://SET-FRONTEND-DOMAIN.up.railway.app"
      }
    },
    "frontend": {
      "type": "github",
      "repo": "zenjahid/mini-kanban-board",
      "branch": "master",
      "rootDirectory": "frontend",
      "build": {
        "builder": "DOCKERFILE"
      },
      "deploy": {
        "healthcheckPath": "/",
        "healthcheckTimeout": 180,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "variables": {
        "NEXT_PUBLIC_API_URL": "https://SET-BACKEND-DOMAIN.up.railway.app/api"
      }
    }
  }
}